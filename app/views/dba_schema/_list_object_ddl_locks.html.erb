<%
  @update_area = get_unique_area_id

  # Column descriptions from Oracle Database Reference for V$LIBCACHE_LOCKS, V$DB_OBJECT_CACHE and V$SESSION
  column_options = []
  column_options << { caption: 'I',               data: proc{|rec| rec.inst_id},          title: 'RAC instance of the session', align: :right} if PanoramaConnection.rac?
  column_options << { caption: 'SID',             data: proc{|rec| link_session_details(@update_area, rec.inst_id, rec.sid, rec.serial_no, print_val: rec.sid) }, title: "Session identifier\nLink shows the session details", align: :right}
  column_options << { caption: 'Serial#',         data: proc{|rec| rec.serial_no},        title: 'Session serial number', align: :right}
  column_options << { caption: 'User',            data: proc{|rec| rec.username},         title: 'Oracle username'}
  column_options << { caption: 'Program',         data: proc{|rec| rec.program},          title: 'Operating system program name'}
  column_options << { caption: 'Owner',           data: proc{|rec| rec.owner},            title: 'Owner of the object'}
  column_options << { caption: 'Name',            data: proc{|rec| rec.name},             title: 'Name of the object'}
  column_options << { caption: 'Type',            data: proc{|rec| rec.type},             title: 'Type of the object'}
  column_options << { caption: 'Mode held',       data: proc{|rec| rec.mode_held},        title: "Lock mode held:\n0 - No lock held (None)\n1 - Null mode\n2 - Share mode\n3 - Exclusive mode"}
  column_options << { caption: 'Mode requested',  data: proc{|rec| rec.mode_requested},   title: "Lock mode requested:\n0 - No lock requested (None)\n1 - Null mode\n2 - Share mode\n3 - Exclusive mode", data_style: proc{|rec| 'background-color: orange;' unless ['None', 'Null'].include?(rec.mode_requested)}}
%>

<%= gen_slickgrid(@ddl_locks, column_options, {
  caption:        "Sessions with initialized state (library cache locks) on #{@object_type} #{@owner}.#{@object_name} (from GV$LibCache_Locks)",
  max_height:     450,
  show_pin_icon:  1,
  update_area:    @update_area
}) %>
