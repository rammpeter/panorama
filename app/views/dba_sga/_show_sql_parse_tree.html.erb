<%
  caption = String.new
  caption << "<div class=\"flex-row-container\">"

  caption << "<div class=\"flex-row-element\" style=\"font-weight: bold;\">"
  caption << "Parse tree for SQL-ID '#{@sql_id}' (parsed by IslandSQL)"
  caption << "</div>"

  caption << "&nbsp;&nbsp;&nbsp;"

  caption << "<div class=\"flex-row-element\" style=\"font-weight: normal;\" title=\"Direction of the tree layout\">Direction: "
  caption << "<select onchange=\"refresh_parse_tree_#{@current_update_area}({ rankdir: this.value});\">"
  caption << "<option value=\"LR\"#{@rankdir == 'LR' ? ' selected' : ''}>Left to right</option>"
  caption << "<option value=\"TB\"#{@rankdir == 'TB' ? ' selected' : ''}>Top to bottom</option>"
  caption << "</select>"
  caption << "</div>"

  caption << "<div class=\"flex-row-element\" style=\"font-weight: normal;\" title=\"Zoom the graph. 'Fit to width' shows the whole tree, use zoom levels to read the details.\">Zoom: "
  caption << "<select onchange=\"zoom_parse_tree_#{@current_update_area}(this.value);\">"
  caption << "<option value=\"fit\" selected>Fit to width</option>"
  [25, 50, 75, 100].each { |z| caption << "<option value=\"#{z}\">#{z}%</option>" }
  caption << "</select>"
  caption << "</div>"

  caption << "</div>"
%>

<%= render_page_caption(caption.html_safe) %>

<% if @syntax_errors.count > 0 %>
  <div style="color: red;">
    <b>Syntax errors:</b><br/>
    <% @syntax_errors.each do |e| %>
      Line <%= e[:line] %>, column <%= e[:column] %>: <%= e[:message] %><br/>
    <% end %>
  </div>
<% end %>

<%# No flex container here: centering an oversized graph would cut off its left part %>
<div style="overflow-x: auto;" id="<%= @current_update_area %>_graphviz"></div>
<script>
    ensureGraphVizLoaded(function() {
        showIndicator('show_sql_parse_tree');
        Viz.instance()
            .then(viz => {
                $('#<%= @current_update_area %>_graphviz').html(viz.renderSVGElement(<%= @digraph.to_json.html_safe %>));
                zoom_parse_tree_<%= @current_update_area %>('fit');
            })
            .catch(error => {
                console.error(error);
                alert(error);
            })
            .finally(() => {
                hideIndicator('show_sql_parse_tree');
            });
    });

    // The parse tree may be very large, so scale the SVG by its viewBox instead of showing it at natural size
    function zoom_parse_tree_<%= @current_update_area %>(zoom){
        const svg = document.querySelector('#<%= @current_update_area %>_graphviz svg');
        if (!svg) return;
        if (zoom === 'fit') {
            svg.setAttribute('width', '100%');
        } else {
            svg.setAttribute('width', (svg.viewBox.baseVal.width * zoom / 100) + 'pt');
        }
        svg.removeAttribute('height');                                          // height follows width by the aspect ratio of viewBox
    }

    function refresh_parse_tree_<%= @current_update_area %>(changes){
        var current = {
            update_area:  '<%= @current_update_area %>',
            sql_id:       '<%= @sql_id %>',
            rankdir:      '<%= @rankdir %>'
        };
        ajax_html('<%= @current_update_area %>', 'dba_sga', 'show_sql_parse_tree', {...current, ...changes});
    }
</script>
